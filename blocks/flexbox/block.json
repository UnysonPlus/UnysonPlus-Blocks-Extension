{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "unysonplus/flexbox",
	"title": "Flexbox",
	"category": "unysonplus",
	"icon": "editor-insertmore",
	"description": "A flex container that arranges its blocks along an axis.",
