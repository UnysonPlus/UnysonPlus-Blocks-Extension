{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "unysonplus/audio-player",
	"title": "Audio Player",
	"category": "unysonplus",
	"icon": "format-audio",
	"description": "A playlist-capable audio player with volume and download controls.",
	"keywords": [ "audio", "player", "music", "podcast", "playlist", "mp3" ],
	"textdomain": "fw",
