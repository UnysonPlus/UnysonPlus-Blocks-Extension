{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "unysonplus/carousel",
	"title": "Carousel",
	"category": "unysonplus",
	"icon": "images-alt2",
	"description": "A slider of image or content slides, with arrows, dots and autoplay.",
	"keywords": [ "carousel", "slider", "slideshow", "gallery", "slides" ],
	"textdomain": "fw",
	"attributes": {
		"upOptions": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true },
		"html": false
	},
	"editorScript": "fw-block-carousel"
}
