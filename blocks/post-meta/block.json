{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "unysonplus/post-meta",
	"title": "Post Meta Field",
	"category": "unysonplus",
	"icon": "admin-generic",
	"description": "The value of a custom field on the current post.",
	"keywords": [ "custom field", "meta", "acf", "dynamic", "theme builder" ],
	"textdomain": "fw",
	"attributes": {
		"upOptions": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true },
		"html": false
	},
	"editorScript": "fw-block-post-meta"
}
